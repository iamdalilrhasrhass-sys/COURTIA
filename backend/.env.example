# ============================================================
# COURTIA Backend — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# ============================================================

# --- Base de données PostgreSQL ---
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- JWT Authentication ---
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY=7d

# --- Proxy / Rate limiting ---
TRUST_PROXY=1
API_RATE_LIMIT_MAX=1000
API_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
AUTH_ME_RATE_LIMIT_MAX=300
AUTH_ME_RATE_LIMIT_WINDOW_MS=300000
# Optionnel
# HEALTH_RATE_LIMIT_MAX=240
# HEALTH_RATE_LIMIT_WINDOW_MS=60000
# ARK_RATE_LIMIT_MAX=20
# ARK_RATE_LIMIT_WINDOW_MS=60000

# --- Anthropic API (ARK) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Billing mode ---
BILLING_MODE=test

# --- Stripe (TEST MODE uniquement dans cette phase) ---
STRIPE_SECRET_KEY_TEST=sk_test_xxx
STRIPE_WEBHOOK_SECRET_TEST=whsec_xxx
STRIPE_STARTER_PRICE_ID_TEST=price_xxx
STRIPE_PRO_PRICE_ID_TEST=price_xxx
STRIPE_CUSTOMER_PORTAL_RETURN_URL=https://courtia.vercel.app/billing

# Compat legacy (optionnel, à migrer)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_STARTER=
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_PREMIUM=

# --- Telegram (onboarding) ---
TELEGRAM_BOT_TOKEN=your-t...oken

# --- SMS (TextBelt gratuit) ---
SMS_PROVIDER=textbelt
TEXTBELT_API_KEY=textbelt
# TEXTBELT_SELF_HOST_URL=      # Optionnel: auto-hébergement

# --- IMAP (Emails entrants — GRATUIT via Gmail) ---
IMAP_USER=arkcourtia@gmail.com
IMAP_PASSWORD=***
# IMAP_CHECK_INTERVAL_MINUTES=5   # Optionnel: intervalle de vérification

# --- Relances automatiques ---
# DISABLE_RELANCES=true            # Décommenter pour désactiver les relances auto

# --- Serveur ---
PORT=10000
NODE_ENV=production

# --- WhatsApp (Baileys — GRATUIT, auto-hébergé) ---
WHATSAPP_ENABLED=true
WHATSAPP_SESSION_PATH=/root/courtia/whatsapp-session

# --- URLs ---
FRONTEND_URL=https://courtia.vercel.app
BACKEND_URL=https://api.courtiark.fr

# --- Intégrations OAuth / Connecteurs ---
# Chiffrement côté backend pour tokens intégrations (obligatoire pour stocker des tokens)
ENCRYPTION_KEY=replace-with-a-long-random-secret

# Google OAuth (Google Agenda + Gmail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Important: pointer vers /api/integrations/google-calendar/callback (et /gmail/callback si séparé)
GOOGLE_REDIRECT_URI=

# Outlook OAuth
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REDIRECT_URI=
OUTLOOK_TENANT_ID=common

# WhatsApp Business Cloud API (Meta)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
