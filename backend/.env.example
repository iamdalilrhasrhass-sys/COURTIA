# ============================================================
# COURTIA Backend — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# ============================================================

# --- Base de données PostgreSQL ---
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- JWT Authentication ---
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY=7d

# --- Proxy / Rate limiting ---
TRUST_PROXY=1
API_RATE_LIMIT_MAX=1000
API_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
AUTH_ME_RATE_LIMIT_MAX=300
AUTH_ME_RATE_LIMIT_WINDOW_MS=300000
# Optionnel
# HEALTH_RATE_LIMIT_MAX=240
# HEALTH_RATE_LIMIT_WINDOW_MS=60000
# ARK_RATE_LIMIT_MAX=20
# ARK_RATE_LIMIT_WINDOW_MS=60000

# --- Anthropic API (ARK) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Billing mode ---
# test | live
BILLING_MODE=test

# --- Stripe (variables standard) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_CABINET=
STRIPE_CUSTOMER_PORTAL_RETURN_URL=https://app.courtiark.fr/billing

# --- Stripe (optionnel: override test mode dédié) ---
# Si BILLING_MODE=test et ces valeurs sont définies, elles sont prioritaires.
STRIPE_SECRET_KEY_TEST=
STRIPE_WEBHOOK_SECRET_TEST=
STRIPE_STARTER_PRICE_ID_TEST=
STRIPE_PRO_PRICE_ID_TEST=
STRIPE_CABINET_PRICE_ID_TEST=

# --- Telegram (onboarding) ---
TELEGRAM_BOT_TOKEN=your-t...oken

# --- SMS ---
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=

# --- Email transactionnel ---
RESEND_API_KEY=
EMAIL_FROM=COURTIA <noreply@courtiark.fr>
SUPPORT_EMAIL=support@courtiark.fr
DPO_EMAIL=dpo@courtiark.fr

# --- Product analytics ---
POSTHOG_KEY=
POSTHOG_HOST=https://app.posthog.com

# --- IMAP (Emails entrants — GRATUIT via Gmail) ---
IMAP_USER=
IMAP_PASSWORD=
# IMAP_CHECK_INTERVAL_MINUTES=5   # Optionnel: intervalle de vérification

# --- Relances automatiques ---
# DISABLE_RELANCES=true            # Décommenter pour désactiver les relances auto

# --- Serveur ---
PORT=10000
NODE_ENV=production

# --- WhatsApp (Baileys — GRATUIT, auto-hébergé) ---
WHATSAPP_ENABLED=true
WHATSAPP_SESSION_PATH=/root/courtia/whatsapp-session

# --- URLs ---
FRONTEND_URL=https://app.courtiark.fr
BACKEND_URL=https://api.courtiark.fr

# --- CORS ---
CORS_ORIGIN=https://app.courtiark.fr

# --- Intégrations OAuth / Connecteurs ---
# Chiffrement côté backend pour tokens intégrations (obligatoire pour stocker des tokens)
ENCRYPTION_KEY=replace-with-base64-32-byte-key

# Logs / Sentry
LOG_LEVEL=info
LOG_HTTP_REQUESTS=false
SENTRY_DSN_BACKEND=

# Google OAuth (Google Agenda + Gmail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OAuth combiné Google Agenda + Gmail
GOOGLE_REDIRECT_URI=https://app.courtiark.fr/api/integrations/google/oauth/callback
# OAuth séparés optionnels
GOOGLE_CALENDAR_REDIRECT_URI=https://app.courtiark.fr/api/integrations/google-calendar/callback
GOOGLE_GMAIL_REDIRECT_URI=https://app.courtiark.fr/api/integrations/gmail/callback

# Outlook OAuth
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REDIRECT_URI=
OUTLOOK_TENANT_ID=common

# WhatsApp Business Cloud API (Meta)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Yousign e-signature
YOUSIGN_API_KEY=
YOUSIGN_WEBHOOK_SECRET=
YOUSIGN_BASE_URL=https://api.yousign.app/v3

# --- SMTP (emails transactionnels) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Webhooks automation (Make/Zapier) ---
WEBHOOK_INCOMING_SECRET=
