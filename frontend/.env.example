# ============================================================
# COURTIA Frontend — Variables d'environnement
# Copier ce fichier en .env et adapter selon l'environnement
# ============================================================

# API backend (sans / final)
VITE_API_URL=https://api.courtiark.fr

# URL publique application
VITE_APP_URL=https://courtia.vercel.app

# Clé publishable Stripe (frontend uniquement)
VITE_PUBLIC_STRIPE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx

# Feature flags
VITE_ENABLE_GROWTH_LEADS=false
VITE_INTEGRATIONS_API_ENABLED=false
VITE_BILLING_TEST_MODE=true

# Sentry (optionnel, laisser vide pour désactiver)
VITE_SENTRY_DSN_FRONTEND=
