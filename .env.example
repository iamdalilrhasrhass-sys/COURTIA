# ───────────────────────────────────────────────────────
# COURTIA Backend — Exemple de configuration (.env)
# ───────────────────────────────────────────────────────
# Copier ce fichier vers .env et remplir les valeurs
# cp .env.example .env

# ── Base de données ──
DATABASE_URL=postgresql://user:password@localhost:5432/crm_assurance

# ── JWT ──
JWT_SECRET=change_me_to_a_random_long_string

# ── Environnement ──
NODE_ENV=production

# ── Frontend URL ──
FRONTEND_URL=https://app.courtiark.fr

# ── Stripe — Mode (test ou live) ──
BILLING_MODE=live

# ── Stripe — LIVE (prod) ──
STRIPE_SECRET_KEY=sk_live_votre_cle
STRIPE_WEBHOOK_SECRET=whsec_votre_secret
STRIPE_PRICE_STARTER=price_live_xxx
STRIPE_PRICE_PRO=price_live_xxx
STRIPE_PRICE_PREMIUM=price_live_xxx

# ── Stripe — TEST (dev) ──
STRIPE_SECRET_KEY_TEST=sk_test_votre_cle
STRIPE_WEBHOOK_SECRET_TEST=whsec_votre_secret_test
STRIPE_STARTER_PRICE_ID_TEST=price_test_xxx
STRIPE_PRO_PRICE_ID_TEST=price_test_xxx

# ── SMTP — Resend (transactionnel) ──
# Provider: "smtp" (Resend/SendGrid/Brevo) ou "gmail"
EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@courtiark.fr
EMAIL_REPLY_TO=bonjour@courtiark.fr
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASSWORD=re_votre_cle_api_resend

# ── API externes ──
ANTHROPIC_API_KEY=sk-ant-votre_cle
TELEGRAM_BOT_TOKEN=votre_token_telegram

# ── Yousign — Signature électronique (LOT 20) ──
YOUSIGN_API_KEY=votre_cle_api_yousign
YOUSIGN_WEBHOOK_SECRET=votre_secret_webhook_yousign
YOUSIGN_BASE_URL=https://api.yousign.app/v3
YOUSIGN_WEBHOOK_URL=https://api.courtiark.fr/api/signatures/webhook

# ── Google Calendar (LOT 20) ──
GOOGLE_CLIENT_ID=votre_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=votre_client_secret
GOOGLE_REDIRECT_URI=https://api.courtiark.fr/api/calendar/callback

# ── Billing ──
BILLING_TAX_MODE=configurable
BILLING_VAT_LABEL=Prix indiqués hors taxes. TVA applicable au taux en vigueur.
BILLING_SELLER_STATUS=micro-entreprise_to_confirm
STRIPE_CUSTOMER_PORTAL_RETURN_URL=https://app.courtiark.fr/billing

# ── LOT F7 — Intégrations OAuth (laisser vide ⇒ "Configuration requise" propre) ──

# Microsoft Outlook / Office 365 — RDV + Mail sortant
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://api.courtiark.fr/api/integrations/connectors/outlook/callback
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REDIRECT_URI=https://api.courtiark.fr/api/integrations/outlook/callback
OUTLOOK_TENANT_ID=common

# Pennylane / Indy — Compta + Export FEC
PENNYLANE_CLIENT_ID=
PENNYLANE_CLIENT_SECRET=
PENNYLANE_REDIRECT_URI=https://api.courtiark.fr/api/integrations/connectors/pennylane/callback

# Slack / Discord / Zapier — Webhook URL configurable côté utilisateur
# (rien à mettre côté serveur — l'utilisateur saisit l'URL dans /integrations)

# Backend URL (utilisé pour générer les redirects OAuth dynamiquement)
BACKEND_URL=https://api.courtiark.fr
