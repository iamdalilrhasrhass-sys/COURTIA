{
  "version": 2,
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "redirects": [
    {
      "source": "/fr/",
      "destination": "/fr",
      "permanent": true
    },
    {
      "source": "/tarifs/",
      "destination": "/tarifs",
      "permanent": true
    },
    {
      "source": "/contact/",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/fonctionnalites/",
      "destination": "/fonctionnalites",
      "permanent": true
    },
    {
      "source": "/demo/",
      "destination": "/demo",
      "permanent": true
    },
    {
      "source": "/demo-public/",
      "destination": "/demo-public",
      "permanent": true
    },
    {
      "source": "/securite/",
      "destination": "/securite",
      "permanent": true
    },
    {
      "source": "/rgpd/",
      "destination": "/rgpd",
      "permanent": true
    },
    {
      "source": "/changelog/",
      "destination": "/changelog",
      "permanent": true
    },
    {
      "source": "/roadmap/",
      "destination": "/roadmap",
      "permanent": true
    },
    {
      "source": "/status/",
      "destination": "/status",
      "permanent": true
    },
    {
      "source": "/legal/:page/",
      "destination": "/legal/:page",
      "permanent": true
    },
    {
      "source": "/ch/",
      "destination": "/ch",
      "permanent": true
    },
    {
      "source": "/ch/tarifs-logiciel-courtier-chf/",
      "destination": "/ch/tarifs-logiciel-courtier-chf",
      "permanent": true
    },
    {
      "source": "/ch/conformite-intermediaire-assurance-lsa-finma/",
      "destination": "/ch/conformite-intermediaire-assurance-lsa-finma",
      "permanent": true
    },
    {
      "source": "/fr/logiciel-courtier-santé",
      "destination": "/fr/logiciel-courtier-sante",
      "permanent": true
    },
    {
      "source": "/fr/logiciel-courtier-sant%C3%A9",
      "destination": "/fr/logiciel-courtier-sante",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/leads/demo-request",
      "destination": "https://overcome-sweet-ought-managed.trycloudflare.com/api/leads/demo-request"
    },
    {
      "source": "/api/leads/events",
      "destination": "https://overcome-sweet-ought-managed.trycloudflare.com/api/leads/events"
    },
    {
      "source": "/api/sales/(.*)",
      "destination": "/api/sales/[...chemin]"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://courtia.onrender.com/api/$1"
    },
    {
      "source": "/ch",
      "destination": "/ch/index.html"
    },
    {
      "source": "/ch/tarifs-logiciel-courtier-chf",
      "destination": "/ch/tarifs-logiciel-courtier-chf/index.html"
    },
    {
      "source": "/ch/conformite-intermediaire-assurance-lsa-finma",
      "destination": "/ch/conformite-intermediaire-assurance-lsa-finma/index.html"
    },
    {
      "source": "/fr",
      "destination": "/fr/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
