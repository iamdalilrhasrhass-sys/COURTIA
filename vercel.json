{
  "version": 2,
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "redirects": [
    {
      "source": "/fr/",
      "destination": "/fr",
      "permanent": true
    },
    {
      "source": "/tarifs/",
      "destination": "/tarifs",
      "permanent": true
    },
    {
      "source": "/contact/",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/fonctionnalites/",
      "destination": "/fonctionnalites",
      "permanent": true
    },
    {
      "source": "/demo/",
      "destination": "/demo",
      "permanent": true
    },
    {
      "source": "/demo-public/",
      "destination": "/demo-public",
      "permanent": true
    },
    {
      "source": "/securite/",
      "destination": "/securite",
      "permanent": true
    },
    {
      "source": "/rgpd/",
      "destination": "/rgpd",
      "permanent": true
    },
    {
      "source": "/changelog/",
      "destination": "/changelog",
      "permanent": true
    },
    {
      "source": "/roadmap/",
      "destination": "/roadmap",
      "permanent": true
    },
    {
      "source": "/status/",
      "destination": "/status",
      "permanent": true
    },
    {
      "source": "/legal/:page/",
      "destination": "/legal/:page",
      "permanent": true
    },
    {
      "source": "/ch/",
      "destination": "/ch",
      "permanent": true
    },
    {
      "source": "/ch/tarifs-logiciel-courtier-chf/",
      "destination": "/ch/tarifs-logiciel-courtier-chf",
      "permanent": true
    },
    {
      "source": "/ch/conformite-intermediaire-assurance-lsa-finma/",
      "destination": "/ch/conformite-intermediaire-assurance-lsa-finma",
      "permanent": true
    },
    {
      "source": "/fr/logiciel-courtier-santé",
      "destination": "/fr/logiciel-courtier-sante",
      "permanent": true
    },
    {
      "source": "/fr/logiciel-courtier-sant%C3%A9",
      "destination": "/fr/logiciel-courtier-sante",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/leads/demo-request",
      "destination": "https://courtia.onrender.com/api/leads/demo-request"
    },
    {
      "source": "/api/leads/events",
      "destination": "https://courtia.onrender.com/api/leads/events"
    },
    {
      "source": "/api/sales/(.*)",
      "destination": "/api/sales/[...chemin]"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://courtia.onrender.com/api/$1"
    },
    {
      "source": "/ch",
      "destination": "/ch/index.html"
    },
    {
      "source": "/ch/tarifs-logiciel-courtier-chf",
      "destination": "/ch/tarifs-logiciel-courtier-chf/index.html"
    },
    {
      "source": "/ch/conformite-intermediaire-assurance-lsa-finma",
      "destination": "/ch/conformite-intermediaire-assurance-lsa-finma/index.html"
    },
    {
      "source": "/fr",
      "destination": "/fr/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; frame-src 'self' blob: data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; manifest-src 'self'; upgrade-insecure-requests"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), camera=(), microphone=(), payment=(), usb=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" }
      ]
    }
  ]
}
